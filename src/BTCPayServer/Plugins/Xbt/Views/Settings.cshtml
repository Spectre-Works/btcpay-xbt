@model BTCPayServer.Plugins.Xbt.XbtSettings
@{
    Layout = "_Layout";
    ViewData["Title"] = "XBT payments";
    var storeId = Context.Request.RouteValues["storeId"];
}
<div class="sticky-header"><h2>@ViewData["Title"]</h2></div>
<partial name="_StatusMessage" />
<p>Choose whether customers can pay new invoices on-chain. Existing invoices continue to be monitored.</p>
<form method="post" asp-controller="UIXbt" asp-action="Settings" asp-route-storeId="@storeId">
    <div class="card mb-4"><div class="card-body">
        <div class="form-check form-switch mb-2">
            <input asp-for="OnChainEnabled" class="form-check-input" />
            <label asp-for="OnChainEnabled" class="form-check-label">On-chain XBT</label>
        </div>
        <p class="text-secondary">Receive payments directly into a watch-only XBT wallet. Each invoice receives a fresh address and confirmations are tracked by your XBT node. Spending keys remain in your external XBT-compatible wallet.</p>
        <p>Connect a dedicated XBT merchant wallet using its account public key.</p>
        <a href="@Url.Content($"~/stores/{storeId}/onchain/XBT/import/xpub")">Connect an existing wallet</a>
        <span class="mx-2">·</span>
        <a href="@Url.Content($"~/stores/{storeId}/onchain/XBT")">Other wallet setup options</a>
    </div></div>
    <p class="text-secondary">Server-side spending, payouts, refunds, PayJoin, and hardware-wallet signing are not supported.</p>
    <button type="submit" class="btn btn-primary">Save payment settings</button>
</form>
